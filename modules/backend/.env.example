# API Keys
HF_TOKEN=your_huggingface_token_here
AAI_API_KEY=your_assemblyai_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./database/transcriptions.db
# Para PostgreSQL: postgresql://user:password@localhost:5432/transcription_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=2020
DEBUG=False

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Services Configuration
DIARIZATION_SERVICE_URL=http://localhost:8001
WHISPER_SERVICE_URL=http://localhost:8000
ASSEMBLYAI_SERVICE_URL=http://localhost:8002

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=500
ALLOWED_EXTENSIONS=mp3,wav,mp4,mpeg,m4a,flac

# Processing Configuration
DEFAULT_TRANSCRIPTION_MODEL=whisper
MIN_SEGMENT_DURATION=0.7
SILENCE_THRESHOLD=-30
